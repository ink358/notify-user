# notify-user 密钥模板 —— 复制到 skill 目录**之外**再填真值
#
#   python scripts/notify.py init     # 自动复制到 ~/.agents/secrets/notify-user.env
#
# 规则:
#   * 这个文件里出现的任何东西都只该留在本机,不要提交、不要贴进对话。
#   * 想彻底不让 agent 读到,填好后跑:python scripts/notify.py lock
#     会用口令加密成 notify-user.env.enc;没有 NOTIFY_PASSPHRASE 谁(包括 agent)都读不出明文。
#   * 位置可用环境变量 NOTIFY_ENV 覆盖。

# 不填则用 auto(按下面顺序挑第一个配置齐的渠道)
NOTIFY_DEFAULT_CHANNEL=auto
NOTIFY_CHANNEL_ORDER=telegram,smtp,resend,serverchan,pushplus

# 本机需要代理才能连 Telegram / Resend 时才填;不填则**忽略**系统里的 *_proxy
# NOTIFY_PROXY=http://127.0.0.1:7890

# ---------------------------------------------------------------- Telegram(最快到达)
# @BotFather → /newbot 拿 token;给机器人发一条消息后用
# https://api.telegram.org/bot<token>/getUpdates 里的 chat.id
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ---------------------------------------------------------------- SMTP(现成邮箱即可,不需要自有域名)
# QQ 邮箱:设置→账户→开启 SMTP 服务,密码填**授权码**
#   SMTP_HOST=smtp.qq.com      SMTP_PORT=465   SMTP_SSL=true
# 163:      SMTP_HOST=smtp.163.com     SMTP_PORT=465   SMTP_SSL=true
# Gmail:    SMTP_HOST=smtp.gmail.com   SMTP_PORT=587   SMTP_SSL=false (STARTTLS,用应用专用密码)
# Outlook:  SMTP_HOST=smtp.office365.com SMTP_PORT=587 SMTP_SSL=false
SMTP_HOST=
SMTP_PORT=465
SMTP_SSL=true
SMTP_USER=
SMTP_PASSWORD=
# 不填则用 SMTP_USER 当发件地址
SMTP_FROM=
SMTP_TO=

# ---------------------------------------------------------------- Resend(API,发给任意收件人需自有已验证域名)
RESEND_API_KEY=
# 没有已验证域名时只能是 onboarding@resend.dev,且只能发给账号本人
RESEND_FROM=
RESEND_TO=

# ---------------------------------------------------------------- Server酱(微信「Server酱」服务号,免费版有每日条数限制)
# https://sct.ftqq.com/ 微信扫码登录 → 「SendKey」页面复制
SERVERCHAN_KEY=

# ---------------------------------------------------------------- PushPlus(微信「pushplus 推送加」公众号,免费版有每日条数限制)
# https://www.pushplus.plus/ 微信扫码登录 → 复制 token
PUSHPLUS_TOKEN=

# ---------------------------------------------------------------- moakt(浏览器驱动,无密钥)
MOAKT_NAME=notification
MOAKT_DOMAIN=drmail.in
MOAKT_TO=
